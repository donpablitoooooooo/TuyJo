rules_version = '2';

// ═══════════════════════════════════════════════════════════════════
// Chi può entrare in una chat
// ═══════════════════════════════════════════════════════════════════
// Ogni chat (families/{familyId}) è accessibile solo ai login anonimi dei
// suoi due telefoni, elencati in `member_uids`. Si entra solo passando dalla
// Cloud Function joinFamily, che verifica una firma fatta con la chiave
// privata del telefono (functions/membership.js): i client non possono
// toccare `member_uids`, `uid_by_user` e `locked`.
//
// Transizione dalla 1.37: le chat che non hanno ancora tutti e due i
// telefoni registrati (`locked` assente o false) restano aperte come prima,
// così chi non ha aggiornato non perde l'accesso. Quando entra il secondo
// telefono joinFamily mette `locked: true` e da lì valgono solo i membri.
// Quando la 1.37 non è più in giro, LEGACY_OPEN va messo a false.

service cloud.firestore {
  match /databases/{database}/documents {

    function legacyOpenAllowed() {
      return true; // LEGACY_OPEN — mettere a false quando non ci sono più telefoni con la 1.37
    }

    function familyPath(familyId) {
      return /databases/$(database)/documents/families/$(familyId);
    }

    function isMemberOf(data) {
      return request.auth != null
        && data.get('member_uids', {}).get(request.auth.uid, false) == true;
    }

    function canEnter(data) {
      return isMemberOf(data)
        || (legacyOpenAllowed() && data.get('locked', false) != true);
    }

    // Per le sottocollezioni. Con la 1.37 il documento della chat spesso
    // non esiste (l'app scriveva solo nelle sottocollezioni): finché dura la
    // transizione una chat senza documento è una chat vecchia, aperta.
    // Dalla 1.38 il documento lo crea joinFamily prima di ogni altro accesso.
    function canAccessFamily(familyId) {
      return exists(familyPath(familyId))
        ? canEnter(get(familyPath(familyId)).data)
        : legacyOpenAllowed();
    }

    // Campi che decide solo joinFamily.
    function touchesMembership() {
      return request.resource.data.diff(resource == null ? {} : resource.data)
        .affectedKeys().hasAny(['member_uids', 'uid_by_user', 'locked']);
    }

    match /families/{familyId} {
      allow list: if false;
      // Una chat che non esiste si può interrogare: non rivela niente.
      allow get: if resource == null || canEnter(resource.data);
      // Di norma la crea joinFamily. I telefoni con la 1.37 la creano
      // ancora loro all'abbinamento: finché c'è la transizione si permette,
      // ma senza poter scrivere i campi dei membri.
      allow create: if legacyOpenAllowed() && !touchesMembership();
      allow update: if canEnter(resource.data) && !touchesMembership();
      allow delete: if canEnter(resource.data);

      // Tutte le sottocollezioni (messaggi, utenti, letture, posizioni,
      // deposito del certificato, chiamate…). `{collection}` obbliga ad
      // almeno un livello: il documento della chat resta alle regole sopra.
      match /{collection}/{document=**} {
        allow read, write: if canAccessFamily(familyId);
      }
    }

    // Richieste di recupero: id casuale a 256 bit, conosciuto solo da chi
    // inquadra il QR. Il telefono nuovo non è ancora membro di niente.
    match /recovery_requests/{requestId} {
      allow list: if false;
      allow get, create, update, delete: if request.auth != null;
    }

    // Segnali di abbinamento: id = SHA-256 della chiave pubblica.
    match /pairing_signals/{signalId} {
      allow list: if false;
      allow get, create, update, delete: if request.auth != null;
    }
  }
}
