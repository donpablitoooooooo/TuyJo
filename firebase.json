{
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "runtime": "nodejs22",
      "region": "europe-west1",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ]
    }
  ],
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "site": "youandme-b3b4c",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "source": "/privacy-it.html",
        "destination": "/privacy-it-v1.1.html",
        "type": 301
      },
      {
        "source": "/privacy-en.html",
        "destination": "/privacy-en-v1.1.html",
        "type": 301
      },
      {
        "source": "/privacy-es.html",
        "destination": "/privacy-es-v1.1.html",
        "type": 301
      },
      {
        "source": "/privacy-ca.html",
        "destination": "/privacy-ca-v1.1.html",
        "type": 301
      }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  },
  "emulators": {
    "firestore": {
      "host": "127.0.0.1",
      "port": 8080
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4500
    },
    "ui": {
      "enabled": false
    }
  }
}
