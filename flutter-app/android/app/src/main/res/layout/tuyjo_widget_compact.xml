<?xml version="1.0" encoding="utf-8"?>
<!-- Widget TuyJo, formato compatto (2x1, come il calendario di sistema):
     una riga piccola (data del todo o "Il mio amore"), una riga grande
     (testo del todo o "4 messaggi nuovi"), cornetta a destra. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/tuyjo_widget_bg"
    android:paddingStart="14dp"
    android:paddingTop="8dp"
    android:paddingEnd="10dp"
    android:paddingBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:layout_marginEnd="46dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/header_icon"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/ic_widget_favorite" />

            <TextView
                android:id="@+id/header_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="5dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="TuyJo"
                android:textColor="#E6FFFFFF"
                android:textSize="11sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/more"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/tuyjo_widget_pill_bg"
                android:paddingStart="6dp"
                android:paddingEnd="6dp"
                android:textColor="#145A60"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <TextView
                android:id="@+id/header_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:background="@drawable/tuyjo_widget_badge_bg"
                android:gravity="center"
                android:minWidth="18dp"
                android:paddingStart="5dp"
                android:paddingEnd="5dp"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/big_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="TuyJo"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold" />
    </LinearLayout>

    <ImageView
        android:id="@+id/call"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:layout_gravity="center_vertical|end"
        android:background="@drawable/tuyjo_widget_call_bg"
        android:contentDescription="Call"
        android:padding="9dp"
        android:src="@drawable/ic_widget_call" />
</FrameLayout>
