<?xml version="1.0" encoding="utf-8"?>
<!--
    Tuijo non usa Android Auto Backup.
    Il certificato viene custodito esclusivamente tramite Block Store
    (cloud automatico, account Google) o file manuale scelto dall'utente.
    I messaggi non vengono mai inclusi in nessun backup automatico.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
