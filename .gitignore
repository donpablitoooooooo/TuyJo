# macOS / IDE
.DS_Store
.idea/

# Firebase CLI cache e log
.firebase/
firebase-debug.log
*.log

# Cartelle di lavoro locali (non fanno parte del progetto)
# Lo slash iniziale è necessario: senza, la regola prende QUALSIASI cartella
# chiamata screenshots, compresa store/screenshots, che invece è del progetto
# (generatore delle immagini per store e sito).
/public_old/
/screenshots/

# Build Android (già ignorata dentro flutter-app, qui per il root)
flutter-app/android/build/
flutter-app/android/.gradle/

# Generati da flutter pub get, specifici della macchina
flutter-app/ios/Flutter/Generated.xcconfig
flutter-app/ios/Flutter/flutter_export_environment.sh
