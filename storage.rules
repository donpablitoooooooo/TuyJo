rules_version = '2';

// Stessa logica di firestore.rules: i file di una chat sono accessibili solo
// ai login anonimi registrati in families/{familyId}.member_uids. Le chat
// non ancora chiuse (`locked` assente o false, telefoni con la 1.37) restano
// aperte finché dura la transizione — vedi LEGACY_OPEN in firestore.rules.
// I file sono tutti cifrati sul telefono prima dell'upload.

service firebase.storage {
  match /b/{bucket}/o {

    function legacyOpenAllowed() {
      return true; // LEGACY_OPEN — tenere allineato con firestore.rules
    }

    function familyPath(familyId) {
      return /databases/(default)/documents/families/$(familyId);
    }

    // Una chat senza documento è una chat della 1.37: aperta finché dura la
    // transizione (vedi firestore.rules).
    function canAccessFamily(familyId) {
      return firestore.exists(familyPath(familyId))
        ? ((request.auth != null
            && firestore.get(familyPath(familyId)).data.get('member_uids', {}).get(request.auth.uid, false) == true)
          || (legacyOpenAllowed()
            && firestore.get(familyPath(familyId)).data.get('locked', false) != true))
        : legacyOpenAllowed();
    }

    // Allegati e miniature (cifrati). Massimo 100 MB a file.
    match /families/{familyId}/attachments/{type}/{allPaths=**} {
      allow read, delete: if canAccessFamily(familyId);
      allow create, update: if canAccessFamily(familyId)
        && request.resource.size < 100 * 1024 * 1024;
    }

    // Selfie di coppia (cifrato).
    match /families/{familyId}/{fileName} {
      allow read, delete: if canAccessFamily(familyId);
      allow create, update: if canAccessFamily(familyId)
        && request.resource.size < 20 * 1024 * 1024;
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
